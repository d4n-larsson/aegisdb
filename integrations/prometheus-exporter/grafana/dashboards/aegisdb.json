    {
      "id": 17,
      "type": "timeseries",
      "title": "Distillation backlog (opt-in: AEGIS_EXPORTER_DISTILLATION=1)",
      "description": "How far behind the summarizer is. `backlog` is how many records are eligible; `oldest` is how long the eldest has waited, which is what separates a steady trickle from a job that stopped running. Absent entirely unless enabled \u2014 a flat 0 would mean 'no backlog' and a missing series means 'not measured', and those are opposite things.\n\n**Watch `capped`.** Past the server's --query-scan-cap the backlog is a floor, not a total, and the alert you build on it is wrong by an unknown amount.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aegisdb-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegisdb_distillation_backlog",
          "legendFormat": "backlog (records eligible)",
          "datasource": {
            "type": "prometheus",
            "uid": "aegisdb-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aegisdb_distillation_oldest_age_seconds",
          "legendFormat": "oldest waiting (seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "aegisdb-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "aegisdb_distillation_backlog_capped",
          "legendFormat": "backlog is a floor (scan cap hit)",
          "datasource": {
            "type": "prometheus",
            "uid": "aegisdb-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
