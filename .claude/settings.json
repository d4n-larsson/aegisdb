{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AEGIS_RECALL_TOP_K=3 python3 \"$CLAUDE_PROJECT_DIR/integrations/claude-code/hooks/recall_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AEGIS_EMBEDDING_MODE=local AEGIS_EMBEDDING_DIMENSIONS=384 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/integrations/claude-code/hooks/capture_hook.py\""
          }
        ]
      }
    ]
  }
}
